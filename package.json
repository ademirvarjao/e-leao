{
  "name": "e-leao",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "rtc:dados": "python3 scripts/import-rtc-catalog.py --prepare",
    "predev": "npm run rtc:dados",
    "prebuild": "npm run rtc:dados",
    "dev": "vite --host 0.0.0.0",
